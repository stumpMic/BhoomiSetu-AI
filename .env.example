# ==========================================
# BhoomiSetu AI - Root Environment Template
# ==========================================

# Application
APP_NAME=BhoomiSetu AI
APP_ENV=development
SECRET_KEY=bhoomisetu-ai-super-secret-key-change-in-production-2026
DEBUG=true

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (Default: SQLite for instant local zero-config execution; PostgreSQL/PostGIS optional)
DATABASE_URL=sqlite:///./database/bhoomisetu.db
# DATABASE_URL=postgresql://bhoomisetu_user:bhoomisetu_pass@localhost:5432/bhoomisetu_db

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_MOCK_API=false

# Machine Learning
ML_MODEL_PATH=./machine-learning/models
ML_CONFIDENCE_THRESHOLD=0.70

# OCR Engine (mock fallback automatically active if Tesseract binary is omitted)
TESSERACT_CMD=tesseract
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_MB=15

# Mock SMS Notification
ENABLE_MOCK_SMS=true
